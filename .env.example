# === Telegram ===
TELEGRAM_BOT_TOKEN=
# The deployed Mini App URL, e.g. https://your-username.github.io/vireli/
# Sent as the "Open App" button when a user sends /start to the bot.
TELEGRAM_WEBAPP_URL=
# Any long random string you generate yourself (e.g. `openssl rand -hex 32`).
# Used to verify that webhook calls really come from Telegram - see README
# "Register the Telegram webhook" section for how this gets registered.
TELEGRAM_WEBHOOK_SECRET=

# === Supabase (Database + Storage) ===
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> Project API keys -> service_role (secret, NOT anon key)
SUPABASE_SERVICE_KEY=
# Project Settings -> Database -> Connection string -> URI (use the direct connection, port 5432)
DATABASE_URL=

# === AI providers ===
OPENROUTER_API_KEY=
HUGGINGFACE_API_TOKEN=
SBER_AUTH_KEY=

# === App config ===
ENVIRONMENT=development
# Origin of the deployed frontend (GitHub Pages URL), used for CORS
FRONTEND_ORIGIN=https://your-username.github.io
